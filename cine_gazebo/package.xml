<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cine_gazebo</name>
  <version>1.0.0</version>
  <description>Gazebo Harmonic world, drone model with the Pi camera's lens, and Gazebo-to-ROS bridges for flying the CINE stack against ArduPilot SITL.</description>
  <maintainer email="fishnos@users.noreply.github.com">fishnos</maintainer>
  <license>GPL-3.0-only</license>

  <url type="repository">https://github.com/Kino-Studios/CINE</url>
  <url type="bugtracker">https://github.com/Kino-Studios/CINE/issues</url>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>cine_agent</exec_depend>
  <exec_depend>cine_bringup</exec_depend>
  <exec_depend>cine_sensing_config</exec_depend>
  <exec_depend>cine_sensing_imu</exec_depend>
  <exec_depend>cine_sensing_setpoint</exec_depend>
  <exec_depend>cine_sensing_yolo</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>mavros</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_image</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>vins</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
