<?xml version="1.0"?>
<model>
  <name>CINE Source One</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>fishnos</name>
    <email>fishnos@users.noreply.github.com</email>
  </author>

  <description>
    The CINE drone's real airframe: a TBS Source One 5-inch frame with EMAX ECO II 2207
    1700KV motors, Gemfan 51366 props, a 6S battery and the Pi stack, carrying the same
    fixed forward Pi camera as cine_iris. model.sdf is rendered from model.sdf.template by
    gazebo_sim.launch.py.
  </description>
</model>
