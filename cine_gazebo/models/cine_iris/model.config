<?xml version="1.0"?>
<model>
  <name>CINE Iris</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>fishnos</name>
    <email>fishnos@users.noreply.github.com</email>
  </author>

  <description>
    ardupilot_gazebo's iris_with_ardupilot with a fixed forward camera that has the
    resolution, focal length and lens distortion of the CINE drone's Pi camera.
    model.sdf is rendered from model.sdf.template by gazebo_sim.launch.py.
  </description>
  <depend>
    <model>
      <uri>model://iris_with_standoffs</uri>
      <version>1.0</version>
    </model>
  </depend>
</model>
