<?xml version="1.0"?>
<!--
  Template for the CINE drone in Gazebo: ardupilot_gazebo's iris_with_ardupilot (commit
  f116b03552d05c8d0b0bed5ed67033a1183121d1, models/iris_with_ardupilot/model.sdf; its
  commented-out debugging markers are left out) with a fixed forward camera carrying the
  Pi camera's lens. gazebo_sim.launch.py fills {{camera}} and {{imu_noise}} through
  cine_gazebo.model_rendering; never load this file directly.
-->
<sdf version="1.9" xmlns:experimental="http://sdformat.org/schemas/experimental">
  <model name="cine_iris" canonical_link="iris_with_standoffs::base_link">
    <include>
      <uri>model://iris_with_standoffs</uri>
      <!-- WindEffects pushes only links that enable wind, and a link inherits that only
           from its own model, so each link of the included model is switched on here. -->
      <experimental:params>
        <link element_id="base_link">
          <enable_wind action="add">true</enable_wind>
        </link>
        <link element_id="imu_link">
          <enable_wind action="add">true</enable_wind>
        </link>
        <link element_id="rotor_0">
          <enable_wind action="add">true</enable_wind>
        </link>
        <link element_id="rotor_1">
          <enable_wind action="add">true</enable_wind>
        </link>
        <link element_id="rotor_2">
          <enable_wind action="add">true</enable_wind>
        </link>
        <link element_id="rotor_3">
          <enable_wind action="add">true</enable_wind>
        </link>
        {{imu_noise}}
      </experimental:params>
    </include>

    <!-- The real camera is fixed to the frame, so no gimbal. Gazebo cameras look along
         their link's +x, which is the drone's forward axis. -->
    <link name="camera_link">
      <pose relative_to="iris_with_standoffs::base_link">0.05 0 0 0 0 0</pose>
      <enable_wind>true</enable_wind>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000001</iyy>
          <iyz>0</iyz>
          <izz>0.000001</izz>
        </inertia>
      </inertial>
      {{camera}}
    </link>
    <joint name="camera_joint" type="fixed">
      <parent>iris_with_standoffs::base_link</parent>
      <child>camera_link</child>
    </joint>

    <!-- Ground truth for logging the estimators against: the model's world pose alone,
         one gz.msgs.Pose per message on /model/cine_iris/pose. -->
    <plugin filename="gz-sim-pose-publisher-system"
      name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>50</update_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
    </plugin>
    <plugin filename="gz-sim-lift-drag-system"
        name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.002</area>
      <air_density>1.2041</air_density>
      <cp>0.084 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>iris_with_standoffs::rotor_0</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system"
        name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.002</area>
      <air_density>1.2041</air_density>
      <cp>-0.084 0 0</cp>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>iris_with_standoffs::rotor_0</link_name>
    </plugin>
