## Optional config for collect_constrained_data.sh
## Copy to collect_constrained_data.env and edit.

# 1 = publish synthetic focus target/depth topics
USE_FAKE_FOCUS=1

# 1 = publish synthetic light vector topic
USE_FAKE_LIGHT=1

# Drone namespace used by ego-planner sim
DRONE_ID=0

# You can also override the computed topics if needed:
# ODOM_TOPIC=/drone_0_visual_slam/odom
