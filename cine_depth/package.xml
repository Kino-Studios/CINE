<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cine_depth</name>
  <version>1.0.0</version>
  <description>Publishes monocular depth images estimated by Depth Anything 3 from the drone camera feed.</description>
  <maintainer email="fishnos@users.noreply.github.com">fishnos</maintainer>
  <license>GPL-3.0-only</license>
  <url type="repository">https://github.com/Kino-Studios/CINE</url>
  <url type="bugtracker">https://github.com/Kino-Studios/CINE/issues</url>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>cine_config</depend>

  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
