<?xml version="1.0"?>
<package format="3">
  <name>cine_msgs</name>
  <version>1.0.0</version>
  <description>ROS 2 messages for the CINE cinematography drone: the cinematography cost breakdown published by cine_agent.</description>
  <maintainer email="fishnos@users.noreply.github.com">fishnos</maintainer>
  <license>GPL-3.0-only</license>
  <url type="repository">https://github.com/Kino-Studios/CINE</url>
  <url type="bugtracker">https://github.com/Kino-Studios/CINE/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <depend>std_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
