<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>poscmd_2_odom</name>
  <version>0.0.0</version>
  <description>Fake drone that integrates position commands directly into odometry, bypassing dynamics.</description>
  <maintainer email="fishnos@users.noreply.github.com">fishnos</maintainer>
  <author>ZJU FAST Lab</author>
  <license>GPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>eigen</depend>
  <depend>quadrotor_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
