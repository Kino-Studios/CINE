## Optional overrides for collect_constrained_data.sh
## Note: These are primarily managed in configs/json_constants/user_params/params.json
## Copy this file to collect_constrained_data.env to override them locally.

# 1 = publish synthetic focus target/depth topics
USE_SIMULATED_FOCUS=1

# 1 = publish synthetic light vector topic
USE_SIMULATED_LIGHT=1

# Drone namespace used by ego-planner sim
DRONE_ID=0

# Target position for simulated focus
TARGET_XYZ="[2.34,4.35,1.35]"

# Focus depth for simulated focus
FOCUS_DEPTH_M=1.5
